# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local (it is git-ignored). This example file contains no real secrets.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=fraud_app
MYSQL_PASSWORD="the-password-you-set-for-fraud_app"
MYSQL_DATABASE=financial_fraud_db

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-a-64-character-random-hex-string-here

# MongoDB Atlas: Database > Connect > Drivers. Replace <db_password> INCLUDING the < > brackets.
MONGODB_URI="mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_APP"
MONGODB_DB=fraud_activity
